---
const callout = (n: number, x: number, y: number) => ({ n, x, y });
const marks = [callout(1, 24, 27), callout(2, 30, 74), callout(3, 216, 74), callout(4, 626, 74), callout(5, 24, 433)];
---

<svg class="dw-svg" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="DepthWizard app layout">
	<rect x="10" y="10" width="780" height="430" rx="8" class="box" />
	<!-- header -->
	<rect x="10" y="10" width="780" height="34" rx="8" class="violet" />
	<text x="46" y="32" class="t-b t-sm">DepthWizard</text>
	<text x="140" y="32" class="t-dim">File  View  Tools  Help</text>
	<text x="290" y="32" class="t-dim">Scenarios ▾   Raw ○</text>
	<rect x="600" y="18" width="110" height="18" rx="9" class="green" />
	<text x="655" y="31" text-anchor="middle" class="t-dim" style="font-size:9.5px">● Model online</text>
	<text x="740" y="32" class="t-dim">[ ]  ◐</text>

	<!-- project panel -->
	<rect x="18" y="52" width="170" height="362" rx="6" class="blue" />
	<text x="46" y="78" class="t-b t-sm">Project</text>
	<rect x="30" y="90" width="146" height="60" rx="4" class="group" />
	<text x="103" y="124" text-anchor="middle" class="t-dim">Drop PNG / JPG / TIFF</text>
	<rect x="30" y="160" width="146" height="54" rx="4" class="box" />
	<text x="40" y="180" class="t-dim">image card · GSD · EPSG</text>
	<text x="40" y="198" class="t-dim">georeferenced badge</text>
	<text x="30" y="236" class="t-dim">Resolution (m/px)</text>
	<rect x="30" y="242" width="146" height="20" rx="3" class="box" />
	<text x="38" y="256" class="t-dim" style="font-size:9.5px">Auto · 0.3 · 0.5 · 0.6 · 1.0</text>
	<text x="30" y="284" class="t-dim">Higher quality (TTA)  ○</text>
	<rect x="30" y="296" width="146" height="26" rx="4" class="fill-blue" />
	<text x="103" y="313" text-anchor="middle" style="fill:#fff;font-size:11px;font-weight:600">Estimate heights</text>
	<text x="30" y="346" class="t-dim">Result: range · median</text>
	<text x="30" y="362" class="t-dim">share &lt; 1 m · grid</text>

	<!-- viewport -->
	<rect x="196" y="52" width="410" height="362" rx="6" class="panel" style="fill:var(--dw-panel);stroke:var(--dw-line)" />
	<text x="240" y="78" class="t-b t-sm">Viewport</text>
	<rect x="210" y="88" width="150" height="22" rx="4" class="box" />
	<text x="285" y="103" text-anchor="middle" class="t-dim" style="font-size:9.5px">3D DSM · Height map · Input</text>
	<rect x="210" y="118" width="26" height="92" rx="4" class="box" />
	<text x="223" y="170" text-anchor="middle" class="t-dim" style="font-size:9px">tools</text>
	<rect x="566" y="88" width="28" height="100" rx="4" class="box" />
	<text x="580" y="140" text-anchor="middle" class="t-dim" style="font-size:9px">nav</text>
	<circle cx="580" cy="212" r="12" class="box" />
	<text x="580" y="216" text-anchor="middle" class="t-dim" style="font-size:9px">N</text>
	<path d="M250 350 L330 250 L380 290 L440 210 L520 330 L560 350 Z" class="blue" style="fill-opacity:.5" />
	<rect x="300" y="190" width="30" height="60" class="orange" />
	<rect x="410" y="180" width="24" height="70" class="orange" />
	<rect x="210" y="372" width="180" height="30" rx="4" class="box" />
	<text x="300" y="391" text-anchor="middle" class="t-dim" style="font-size:9.5px">scale bar · colorbar · legend</text>
	<rect x="440" y="372" width="154" height="30" rx="4" class="box" />
	<text x="517" y="391" text-anchor="middle" class="t-dim" style="font-size:9.5px">hover card · product chip</text>

	<!-- inspector -->
	<rect x="614" y="52" width="168" height="362" rx="6" class="blue" />
	<text x="642" y="78" class="t-b t-sm">Inspector</text>
	<rect x="626" y="90" width="144" height="22" rx="4" class="box" />
	<text x="698" y="105" text-anchor="middle" class="t-dim" style="font-size:9.5px">Layers · Validation · Info</text>
	<text x="626" y="136" class="t-dim">Drape layer</text>
	<text x="626" y="154" class="t-dim">Colormap · range</text>
	<text x="626" y="172" class="t-dim">Exaggeration 0.2–8×</text>
	<text x="626" y="190" class="t-dim">Mesh detail</text>
	<text x="626" y="208" class="t-dim">Shadows · AO · sun</text>
	<text x="626" y="226" class="t-dim">3D objects</text>
	<text x="626" y="244" class="t-dim">Surroundings</text>

	<!-- status bar -->
	<rect x="10" y="420" width="780" height="20" rx="0" class="violet" />
	<text x="46" y="434" class="t-dim" style="font-size:9.5px">x, y · height · slope · lat/lon · GSD · product · EPSG · vertices · camera · fps</text>

	{
		marks.map((c) => (
			<g>
				<circle cx={c.x} cy={c.y} r="9" class="fill-orange" />
				<text x={c.x} y={c.y + 3.5} text-anchor="middle" style="fill:#fff;font-size:10px;font-weight:700">{c.n}</text>
			</g>
		))
	}
</svg>
