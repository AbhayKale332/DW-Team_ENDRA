---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-toggle>
	<button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" title="Switch to dark mode">
		<Icon name="sun" size="0.8rem" class="sun" />
		<Icon name="moon" size="0.8rem" class="moon" />
		<span class="thumb"></span>
	</button>
</starlight-theme-toggle>

<script>
	class StarlightThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button');
			if (!button) return;

			const sync = () => {
				const isDark = document.documentElement.dataset.theme !== 'light';
				button.setAttribute('aria-checked', String(isDark));
				button.title = `Switch to ${isDark ? 'light' : 'dark'} mode`;
			};

			sync();
			button.addEventListener('click', () => {
				const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				try {
					localStorage.setItem('starlight-theme', theme);
				} catch {}
				sync();
			});
		}
	}

	customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>

<style>
	.theme-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		width: 2.75rem;
		height: 1.5rem;
		padding: 0 0.2rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.theme-toggle:hover {
		border-color: var(--sl-color-accent);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.sun,
	.moon {
		z-index: 1;
	}

	.thumb {
		position: absolute;
		top: 0.125rem;
		left: 0.125rem;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 50%;
		background: var(--sl-color-white);
		box-shadow: 0 1px 3px rgb(0 0 0 / 24%);
		transition: transform 160ms ease;
	}

	:global(html[data-theme='dark']) .thumb {
		transform: translateX(1.125rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.thumb { transition: none; }
	}
</style>
