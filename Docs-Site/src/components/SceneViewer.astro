---
/**
 * Interactive mini 3D viewer for a scene packed into public/samples/<sample>/
 * by scripts/make_campus_sample.py or scripts/make_dwproj_sample.py.
 * three.js loads lazily when the viewer scrolls near the viewport.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	sample: string;
	/** Status bar text: sensor, GSD, size, CRS. */
	label: string;
	fallback?: ImageMetadata;
	height?: number;
}
const { sample, label, fallback, height = 520 } = Astro.props;
const fb = fallback ? await getImage({ src: fallback, width: 1200 }) : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataBase = `${base}/samples/${sample}/`;
---

<figure class="cv not-content" data-base={dataBase}>
	<div class="stage" style={`height:${height}px`}>
		<div class="canvas-host"></div>

		<div class="bar top-left">
			<div class="seg" role="radiogroup" aria-label="Drape layer">
				<button type="button" data-layer="optical" aria-pressed="true">Optical</button>
				<button type="button" data-layer="height" aria-pressed="false">Height</button>
				<button type="button" data-layer="classes" aria-pressed="false">Classes</button>
			</div>
		</div>
		<div class="bar top-right">
			<label class="exag" title="Vertical exaggeration">
				<span>Exaggeration</span>
				<input type="range" min="1" max="3" step="0.1" value="1" aria-label="Vertical exaggeration" />
				<output>1.0×</output>
			</label>
			<button type="button" class="icon" data-action="reset" title="Reset view" aria-label="Reset view">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path></svg>
			</button>
			<button type="button" class="icon" data-action="fullscreen" title="Fullscreen" aria-label="Fullscreen">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>
			</button>
		</div>

		<div class="hover" hidden></div>

		<div class="legend height-legend" hidden>
			<div class="ramp"></div>
			<div class="ticks"><span>0 m</span><span class="hmax"></span></div>
		</div>
		<div class="legend class-legend" hidden>
			<span><i style="background:#c8b58a"></i>Ground</span>
			<span><i style="background:#9ccc65"></i>Low veg.</span>
			<span><i style="background:#e05a47"></i>Building</span>
			<span><i style="background:#3a8fd9"></i>Water</span>
			<span><i style="background:#5f6368"></i>Road</span>
			<span><i style="background:#2e7d32"></i>Tree</span>
		</div>

		<div class="status">
			<span>{label}</span>
			<span class="readout"></span>
		</div>

		<button type="button" class="gate">
			<span class="gate-inner">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"></path><path d="m2 17 10 5 10-5"></path><path d="m2 12 10 5 10-5"></path></svg>
				<span class="gate-text">Loading 3D scene…</span>
			</span>
		</button>

		<img class="fallback" src={fb ? fb.src : `${dataBase}rgb.jpg`} alt="Static view of the scene" loading="lazy" hidden />
	</div>
	<figcaption><slot /></figcaption>
</figure>

<style>
	.cv {
		margin: 1.5rem 0;
	}
	.stage {
		position: relative;
		border: 1px solid var(--dw-line);
		border-radius: var(--dw-radius);
		overflow: hidden;
		background: radial-gradient(120% 90% at 50% 0%, var(--dw-surface) 0%, var(--dw-panel) 70%);
		touch-action: none;
	}
	.stage:fullscreen {
		border-radius: 0;
		height: 100vh !important;
	}
	.canvas-host,
	.canvas-host :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100% !important;
		height: 100% !important;
		display: block;
	}
	.bar {
		position: absolute;
		top: 10px;
		display: flex;
		gap: 6px;
		align-items: center;
		z-index: 3;
	}
	.top-left {
		left: 10px;
	}
	.top-right {
		right: 10px;
	}
	.seg,
	.exag,
	.icon {
		background: color-mix(in srgb, var(--dw-surface) 88%, transparent);
		backdrop-filter: blur(6px);
		border: 1px solid var(--dw-line);
		border-radius: 6px;
		color: var(--dw-ink);
		font-size: 0.75rem;
	}
	.seg {
		display: flex;
		padding: 2px;
	}
	.seg button {
		all: unset;
		cursor: pointer;
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
		color: var(--dw-dim);
		font-weight: 500;
	}
	.seg button[aria-pressed='true'] {
		background: var(--dw-blue);
		color: #fff;
	}
	.seg button:focus-visible,
	.icon:focus-visible {
		outline: 2px solid var(--dw-blue);
		outline-offset: 1px;
	}
	.exag {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.2rem 0.55rem;
	}
	.exag span {
		color: var(--dw-dim);
	}
	.exag input {
		width: 80px;
		accent-color: var(--dw-blue);
	}
	.exag output {
		font-family: var(--sl-font-mono);
		min-width: 2.4em;
	}
	.icon {
		all: unset;
		box-sizing: border-box;
		cursor: pointer;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--dw-surface) 88%, transparent);
		border: 1px solid var(--dw-line);
		border-radius: 6px;
		color: var(--dw-ink);
	}
	.hover {
		position: absolute;
		right: 10px;
		top: 48px;
		z-index: 3;
		min-width: 210px;
		background: color-mix(in srgb, var(--dw-surface) 94%, transparent);
		backdrop-filter: blur(6px);
		border: 1px solid var(--dw-line);
		border-radius: 8px;
		padding: 0.55rem 0.7rem;
		font-size: 0.75rem;
		color: var(--dw-ink);
		box-shadow: 0 6px 20px rgb(15 23 42 / 12%);
		pointer-events: none;
	}
	.hover :global(.hh) {
		display: flex;
		justify-content: space-between;
		font-weight: 600;
		margin-bottom: 0.25rem;
		gap: 1rem;
	}
	.hover :global(.hs) {
		color: var(--dw-faint);
		margin-bottom: 0.3rem;
	}
	.hover :global(.row) {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--dw-dim);
		line-height: 1.6;
	}
	.hover :global(.row b) {
		color: var(--dw-ink);
		font-weight: 500;
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
	}
	.legend {
		position: absolute;
		left: 10px;
		bottom: 36px;
		z-index: 3;
		background: color-mix(in srgb, var(--dw-surface) 88%, transparent);
		backdrop-filter: blur(6px);
		border: 1px solid var(--dw-line);
		border-radius: 6px;
		padding: 0.4rem 0.55rem;
		font-size: 0.7rem;
		color: var(--dw-dim);
	}
	.height-legend .ramp {
		width: 160px;
		height: 8px;
		border-radius: 2px;
		background: linear-gradient(90deg, rgb(48 18 59), rgb(70 107 227), rgb(40 187 226), rgb(61 231 154), rgb(163 244 78), rgb(231 215 53), rgb(253 152 39), rgb(232 79 13), rgb(122 4 3));
	}
	.height-legend .ticks {
		display: flex;
		justify-content: space-between;
		margin-top: 2px;
		font-family: var(--sl-font-mono);
	}
	.class-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.7rem;
		max-width: 300px;
	}
	.class-legend[hidden],
	.height-legend[hidden] {
		display: none;
	}
	.class-legend i {
		display: inline-block;
		width: 9px;
		height: 9px;
		border-radius: 2px;
		margin-right: 4px;
		vertical-align: -1px;
	}
	.status {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.3rem 0.65rem;
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		color: var(--dw-dim);
		background: color-mix(in srgb, var(--dw-surface) 85%, transparent);
		border-top: 1px solid var(--dw-line);
		white-space: nowrap;
		overflow: hidden;
	}
	.gate {
		all: unset;
		position: absolute;
		inset: 0;
		z-index: 4;
		display: grid;
		place-items: center;
		cursor: pointer;
		background: transparent;
	}
	.gate-inner {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.95rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: #fff;
		background: color-mix(in srgb, #151a20 72%, transparent);
		backdrop-filter: blur(6px);
		box-shadow: 0 6px 24px rgb(0 0 0 / 25%);
	}
	.gate[hidden] {
		display: none;
	}
	.fallback {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 2;
	}
	figcaption {
		font-size: 0.8rem;
		color: var(--dw-dim);
		margin-top: 0.55rem;
		line-height: 1.5;
	}
	figcaption :global(p) {
		margin: 0;
	}
	figcaption :global(a) {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 40rem) {
		.top-right {
			top: 46px;
			left: 10px;
			right: auto;
		}
		.exag span {
			display: none;
		}
		.exag input {
			width: 56px;
		}
		.status span:first-child {
			display: none;
		}
		.hover {
			left: 10px;
			right: 10px;
			top: auto;
			bottom: 36px;
			min-width: 0;
		}
	}
</style>

<script>
	const TURBO: [number, number, number][] = [
		[48, 18, 59], [70, 107, 227], [40, 187, 226], [61, 231, 154], [163, 244, 78],
		[231, 215, 53], [253, 152, 39], [232, 79, 13], [122, 4, 3],
	];
	// Frontend/src/theme/classes.ts, by class id (other, ground, low_veg, building, water, road, tree)
	const CLASS_RGB: [number, number, number][] = [
		[0x9a, 0xa0, 0xa6], [0xc8, 0xb5, 0x8a], [0x9c, 0xcc, 0x65], [0xe0, 0x5a, 0x47],
		[0x3a, 0x8f, 0xd9], [0x5f, 0x63, 0x68], [0x2e, 0x7d, 0x32],
	];
	const CLASS_NAME = ['Other', 'Ground', 'Low vegetation', 'Building', 'Water', 'Road', 'Tree'];

	function turbo(t: number): [number, number, number] {
		const x = Math.min(1, Math.max(0, t)) * (TURBO.length - 1);
		const k = Math.min(TURBO.length - 2, Math.floor(x));
		const f = x - k;
		const a = TURBO[k], b = TURBO[k + 1];
		return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
	}

	/** UTM (northern hemisphere) → WGS84 lat/lon, standard series inversion. */
	function utmToLatLon(E: number, N: number, zone: number): [number, number] {
		const a = 6378137, f = 1 / 298.257223563, k0 = 0.9996;
		const e2 = f * (2 - f), ep2 = e2 / (1 - e2);
		const x = E - 500000, y = N;
		const M = y / k0;
		const mu = M / (a * (1 - e2 / 4 - (3 * e2 * e2) / 64 - (5 * e2 ** 3) / 256));
		const e1 = (1 - Math.sqrt(1 - e2)) / (1 + Math.sqrt(1 - e2));
		const p1 = mu + ((3 * e1) / 2 - (27 * e1 ** 3) / 32) * Math.sin(2 * mu) + ((21 * e1 * e1) / 16 - (55 * e1 ** 4) / 32) * Math.sin(4 * mu) + ((151 * e1 ** 3) / 96) * Math.sin(6 * mu);
		const N1 = a / Math.sqrt(1 - e2 * Math.sin(p1) ** 2);
		const T1 = Math.tan(p1) ** 2, C1 = ep2 * Math.cos(p1) ** 2;
		const R1 = (a * (1 - e2)) / (1 - e2 * Math.sin(p1) ** 2) ** 1.5;
		const D = x / (N1 * k0);
		const lat = p1 - ((N1 * Math.tan(p1)) / R1) * (D * D / 2 - ((5 + 3 * T1 + 10 * C1 - 4 * C1 * C1 - 9 * ep2) * D ** 4) / 24 + ((61 + 90 * T1 + 298 * C1 + 45 * T1 * T1 - 252 * ep2 - 3 * C1 * C1) * D ** 6) / 720);
		const lon0 = ((zone - 1) * 6 - 180 + 3) * (Math.PI / 180);
		const lon = lon0 + (D - ((1 + 2 * T1 + C1) * D ** 3) / 6 + ((5 - 2 * C1 + 28 * T1 - 3 * C1 * C1 + 8 * ep2 + 24 * T1 * T1) * D ** 5) / 120) / Math.cos(p1);
		return [(lat * 180) / Math.PI, (lon * 180) / Math.PI];
	}

	function inPoly(x: number, y: number, poly: number[][]) {
		let inside = false;
		for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
			const [xi, yi] = poly[i], [xj, yj] = poly[j];
			if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
		}
		return inside;
	}

	async function loadImageData(url: string) {
		const img = new Image();
		img.decoding = 'async';
		img.src = url;
		await img.decode();
		const c = document.createElement('canvas');
		c.width = img.naturalWidth;
		c.height = img.naturalHeight;
		const ctx = c.getContext('2d', { willReadFrequently: true })!;
		ctx.drawImage(img, 0, 0);
		return { img, data: ctx.getImageData(0, 0, c.width, c.height), w: c.width, h: c.height };
	}

	async function mount(root: HTMLElement) {
		const stage = root.querySelector<HTMLElement>('.stage')!;
		const host = root.querySelector<HTMLElement>('.canvas-host')!;
		const gate = root.querySelector<HTMLButtonElement>('.gate')!;
		const gateText = root.querySelector<HTMLElement>('.gate-text')!;
		const hoverEl = root.querySelector<HTMLElement>('.hover')!;
		const readout = root.querySelector<HTMLElement>('.readout')!;
		const hLegend = root.querySelector<HTMLElement>('.height-legend')!;
		const cLegend = root.querySelector<HTMLElement>('.class-legend')!;
		const base = root.dataset.base!;

		const fail = (msg: string) => {
			gateText.textContent = msg;
			const fb = root.querySelector<HTMLImageElement>('.fallback');
			if (fb) fb.hidden = false;
		};

		const probe = document.createElement('canvas');
		if (!probe.getContext('webgl2') && !probe.getContext('webgl')) return fail('3D needs WebGL, showing a static render');

		let THREE: typeof import('three');
		let OrbitControls: typeof import('three/examples/jsm/controls/OrbitControls.js').OrbitControls;
		let meta: any, heightsU16: Uint16Array, buildings: any[], rgb: any, seg: any;
		try {
			const [three, oc, m, hb, bj, rgbD, segD] = await Promise.all([
				import('three'),
				import('three/examples/jsm/controls/OrbitControls.js'),
				fetch(base + 'meta.json').then((r) => r.json()),
				fetch(base + 'heights.bin').then((r) => r.arrayBuffer()),
				fetch(base + 'buildings.json').then((r) => r.json()),
				loadImageData(base + 'rgb.jpg'),
				loadImageData(base + 'seg.png'),
			]);
			THREE = three;
			OrbitControls = oc.OrbitControls;
			meta = m;
			heightsU16 = new Uint16Array(hb);
			buildings = bj;
			rgb = rgbD;
			seg = segD;
		} catch (e) {
			console.error(e);
			return fail('Could not load the 3D scene');
		}

		// grid is N (square, campus) or [cols, rows]
		const [GW, GH]: [number, number] = Array.isArray(meta.grid) ? meta.grid : [meta.grid, meta.grid];
		const [SW, SH] = meta.src_px as [number, number];
		const gsd = meta.gsd_m as number;
		const hmax = meta.height_max_m as number;
		const Wm = SW * gsd, Hm = SH * gsd;
		const heights = new Float32Array(GW * GH);
		for (let i = 0; i < heights.length; i++) heights[i] = (heightsU16[i] / 65535) * hmax;
		root.querySelector<HTMLElement>('.hmax')!.textContent = `${meta.height_max_src_m.toFixed(1)} m`;

		// ---------- renderer / scene ----------
		const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.outputColorSpace = THREE.SRGBColorSpace;
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFSoftShadowMap;
		host.appendChild(renderer.domElement);

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(38, 1, 1, 6000);
		// framed for the 614 m campus; scaled to the scene's extent
		const HOME = new THREE.Vector3(-60, 440, 660).multiplyScalar(Math.max(Wm, Hm) / 614);
		camera.position.copy(HOME);

		scene.add(new THREE.HemisphereLight(0xffffff, 0x3a3f46, 1.6));
		const sun = new THREE.DirectionalLight(0xffffff, 2.4);
		sun.position.set(-260, 420, 180);
		sun.castShadow = true;
		sun.shadow.mapSize.set(2048, 2048);
		Object.assign(sun.shadow.camera, { left: -360, right: 360, top: 360, bottom: -360, near: 10, far: 1400 });
		sun.shadow.bias = -0.0006;
		sun.shadow.normalBias = 0.6;
		scene.add(sun);

		// ---------- textures ----------
		const optical = new THREE.Texture(rgb.img);
		optical.colorSpace = THREE.SRGBColorSpace;
		optical.anisotropy = renderer.capabilities.getMaxAnisotropy();
		optical.needsUpdate = true;

		const mkCanvasTex = (w: number, h: number, fill: (px: Uint8ClampedArray) => void) => {
			const c = document.createElement('canvas');
			c.width = w;
			c.height = h;
			const ctx = c.getContext('2d')!;
			const id = ctx.createImageData(w, h);
			fill(id.data);
			ctx.putImageData(id, 0, 0);
			const t = new THREE.CanvasTexture(c);
			t.colorSpace = THREE.SRGBColorSpace;
			t.anisotropy = renderer.capabilities.getMaxAnisotropy();
			return t;
		};
		// height tint over a faint optical base
		const heightTex = mkCanvasTex(SW, SH, (px) => {
			const sx = SW / GW, sy = SH / GH;
			for (let r = 0; r < SH; r++)
				for (let c = 0; c < SW; c++) {
					const hv = heights[Math.min(GH - 1, Math.floor(r / sy)) * GW + Math.min(GW - 1, Math.floor(c / sx))];
					const [R, Gc, B] = turbo(hv / hmax);
					const o = (r * SW + c) * 4;
					const lum = (rgb.data.data[o] * 0.3 + rgb.data.data[o + 1] * 0.59 + rgb.data.data[o + 2] * 0.11) / 255;
					const k = 0.78;
					px[o] = R * k + lum * 255 * (1 - k);
					px[o + 1] = Gc * k + lum * 255 * (1 - k);
					px[o + 2] = B * k + lum * 255 * (1 - k);
					px[o + 3] = 255;
				}
		});
		const classTex = mkCanvasTex(seg.w, seg.h, (px) => {
			for (let i = 0; i < seg.w * seg.h; i++) {
				const id = seg.data.data[i * 4];
				const col = CLASS_RGB[id] ?? CLASS_RGB[0];
				px[i * 4] = col[0];
				px[i * 4 + 1] = col[1];
				px[i * 4 + 2] = col[2];
				px[i * 4 + 3] = 255;
			}
		});
		const textures: Record<string, any> = { optical, height: heightTex, classes: classTex };

		// ---------- terrain ----------
		const geo = new THREE.PlaneGeometry(Wm, Hm, GW - 1, GH - 1);
		geo.rotateX(-Math.PI / 2);
		const pos = geo.attributes.position as any;
		let exag = 1;
		const applyHeights = () => {
			for (let i = 0; i < GW * GH; i++) pos.setY(i, heights[i] * exag);
			pos.needsUpdate = true;
			geo.computeVertexNormals();
			geo.computeBoundingSphere();
		};
		applyHeights();
		const mat = new THREE.MeshStandardMaterial({ map: optical, roughness: 0.92, metalness: 0 });
		const terrain = new THREE.Mesh(geo, mat);
		terrain.castShadow = true;
		terrain.receiveShadow = true;
		scene.add(terrain);

		// base slab
		const slab = new THREE.Mesh(
			new THREE.BoxGeometry(Wm, 10, Hm),
			new THREE.MeshStandardMaterial({ color: 0x2a3038, roughness: 1 }),
		);
		slab.position.y = -5.05;
		slab.receiveShadow = true;
		scene.add(slab);

		// ---------- controls ----------
		const controls = new OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.dampingFactor = 0.08;
		controls.maxPolarAngle = Math.PI * 0.47;
		controls.minDistance = 60;
		controls.maxDistance = 1500;
		controls.screenSpacePanning = false;
		controls.autoRotate = true;
		controls.autoRotateSpeed = 0.45;
		controls.enabled = false;
		controls.target.set(0, 0, 0);
		controls.update();

		// ---------- sizing / render loop ----------
		let visible = true;
		const homeFor = (aspect: number) => HOME.clone().multiplyScalar(aspect < 1.3 ? Math.min(2.2, 1.3 / aspect) : 1);
		let userMoved = false;
		const resize = () => {
			const w = stage.clientWidth, h = stage.clientHeight;
			renderer.setSize(w, h, false);
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			if (!userMoved) camera.position.copy(homeFor(camera.aspect));
		};
		new ResizeObserver(resize).observe(stage);
		resize();
		new IntersectionObserver((es) => (visible = es[0].isIntersecting)).observe(stage);
		renderer.setAnimationLoop(() => {
			if (!visible) return;
			controls.update();
			renderer.render(scene, camera);
		});

		gateText.textContent = 'Click to explore in 3D';
		gate.addEventListener('click', () => {
			gate.hidden = true;
			userMoved = true;
			controls.enabled = true;
			controls.autoRotate = false;
		});

		// ---------- UI ----------
		root.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) =>
			b.addEventListener('click', () => {
				root.querySelectorAll('.seg button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				const layer = b.dataset.layer!;
				mat.map = textures[layer];
				mat.needsUpdate = true;
				hLegend.hidden = layer !== 'height';
				cLegend.hidden = layer !== 'classes';
			}),
		);
		const range = root.querySelector<HTMLInputElement>('.exag input')!;
		const out = root.querySelector<HTMLOutputElement>('.exag output')!;
		let pending = false;
		range.addEventListener('input', () => {
			exag = parseFloat(range.value);
			out.textContent = `${exag.toFixed(1)}×`;
			if (pending) return;
			pending = true;
			requestAnimationFrame(() => {
				applyHeights();
				pending = false;
			});
		});
		root.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
			camera.position.copy(homeFor(camera.aspect));
			controls.target.set(0, 0, 0);
			controls.update();
		});
		root.querySelector('[data-action="fullscreen"]')!.addEventListener('click', () => {
			if (document.fullscreenElement) document.exitFullscreen();
			else stage.requestFullscreen?.();
		});

		// ---------- hover ----------
		const ray = new THREE.Raycaster();
		const ndc = new THREE.Vector2();
		// null for screenshots: no location readout
		const t = meta.crs && meta.transform ? (meta.transform as number[]) : null;
		const zone = t ? parseInt(String(meta.crs).split(':')[1], 10) - 32600 : 0;
		let queued: PointerEvent | null = null;
		const fmt = (v: number, d = 1) => `${v.toFixed(d)} m`;
		const pick = () => {
			const e = queued!;
			queued = null;
			const r = renderer.domElement.getBoundingClientRect();
			ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
			ray.setFromCamera(ndc, camera);
			const hit = ray.intersectObject(terrain, false)[0];
			if (!hit) {
				hoverEl.hidden = true;
				readout.textContent = '';
				return;
			}
			const col = (hit.point.x + Wm / 2) / gsd, row = (hit.point.z + Hm / 2) / gsd;
			if (col < 0 || row < 0 || col >= SW || row >= SH) return;
			const gi = Math.min(GH - 1, Math.floor((row / SH) * GH)) * GW + Math.min(GW - 1, Math.floor((col / SW) * GW));
			const hHere = heights[gi];
			const cls = seg.data.data[(Math.floor(row) * seg.w + Math.floor(col)) * 4];
			let ll = '', llRow = '';
			if (t) {
				const [lat, lon] = utmToLatLon(t[2] + (col + 0.5) * t[0], t[5] + (row + 0.5) * t[4], zone);
				ll = `${lat.toFixed(6)}°N ${lon.toFixed(6)}°E`;
				llRow = `<div class="row"><span>Location</span><b>${ll}</b></div>`;
			}
			readout.textContent = ll ? `h ${fmt(hHere)} · ${ll}` : `h ${fmt(hHere)}`;
			const b = buildings.find((bb) => inPoly(col, row, bb.poly));
			if (b) {
				const floors = Math.max(1, Math.round(b.h / 3));
				hoverEl.innerHTML =
					`<div class="hh"><span>Building</span><span>${fmt(b.h)}</span></div>` +
					`<div class="hs">≈ ${floors} floor${floors > 1 ? 's' : ''} (at 3 m each)</div>` +
					`<div class="row"><span>Highest point</span><b>${fmt(b.h_max)}</b></div>` +
					`<div class="row"><span>Footprint</span><b>${Math.round(b.area_m2).toLocaleString('en')} m²</b></div>` +
					`<div class="row"><span>Height here</span><b>${fmt(hHere)}</b></div>` +
					llRow;
			} else {
				hoverEl.innerHTML =
					`<div class="hh"><span>${CLASS_NAME[cls] ?? 'Surface'}</span><span>${fmt(hHere)}</span></div>` +
					`<div class="row"><span>Height above ground</span><b>${fmt(hHere)}</b></div>` +
					llRow;
			}
			hoverEl.hidden = false;
		};
		renderer.domElement.addEventListener('pointermove', (e) => {
			if (gate.hidden === false) return;
			const first = queued === null;
			queued = e;
			if (first) requestAnimationFrame(pick);
		});
		renderer.domElement.addEventListener('pointerleave', () => {
			hoverEl.hidden = true;
		});
	}

	const roots = document.querySelectorAll<HTMLElement>('.cv');
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				io.unobserve(e.target);
				mount(e.target as HTMLElement);
			}
		},
		{ rootMargin: '300px' },
	);
	roots.forEach((r) => io.observe(r));
</script>
