---
interface Props {
	cols?: number;
}
const { cols = 4 } = Astro.props;
---

<div class="stat-grid not-content" style={`--cols:${cols}`}><slot /></div>

<style>
	.stat-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0;
	}
	@media (max-width: 50rem) {
		.stat-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
