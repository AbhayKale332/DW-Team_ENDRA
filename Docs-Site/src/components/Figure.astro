---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	credit?: string;
	width?: number;
}
const { src, alt, caption, credit, width } = Astro.props;
---

<figure class="dw-figure not-content">
	<Image src={src} alt={alt} width={width} widths={[480, 800, 1200]} sizes="(max-width: 50rem) 100vw, 48rem" />
	{
		(caption || credit) && (
			<figcaption>
				{caption}
				{credit && <span class="credit">{credit}</span>}
			</figcaption>
		)
	}
</figure>

<style>
	.dw-figure {
		margin: 1.5rem 0;
	}
	.dw-figure :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--dw-radius);
		border: 1px solid var(--dw-line);
		display: block;
	}
	figcaption {
		font-size: 0.8rem;
		color: var(--dw-dim);
		margin-top: 0.55rem;
		line-height: 1.5;
	}
	.credit {
		display: block;
		font-size: 0.72rem;
		color: var(--dw-faint);
	}
</style>
