<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Visitor counts · DepthWizard</title>
		<style>
			:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #0d1014; color: #f2f5f7; }
			* { box-sizing: border-box; }
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
			main { width: min(100%, 680px); }
			p { color: #aab4c0; }
			h1 { margin: 0; font-size: clamp(2rem, 7vw, 3.25rem); letter-spacing: -.04em; }
			.eyebrow { margin: 0 0 .6rem; color: #8ca7bb; font: 600 .75rem/1.4 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
			.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
			.card { border: 1px solid #27313b; border-radius: 1rem; padding: 1.4rem; background: #141a20; }
			.label { margin: 0; font-size: .9rem; }
			.value { margin: .5rem 0 0; color: #75d8bb; font-size: clamp(2.5rem, 10vw, 4rem); font-variant-numeric: tabular-nums; line-height: 1; }
			#status, #latest { font-size: .9rem; }
			@media (max-width: 480px) { body { padding: 1.25rem; } .cards { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<main>
			<p class="eyebrow">DepthWizard · private dashboard</p>
			<h1>Visitor counts</h1>
			<p>Homepage loads recorded since tracking began.</p>
			<section class="cards" aria-label="Visit totals" aria-live="polite">
				<article class="card">
					<p class="label">Homepage loads</p>
					<p class="value" id="homepage">—</p>
				</article>
				<article class="card">
					<p class="label">Loads with <code>?ppt</code></p>
					<p class="value" id="ppt">—</p>
				</article>
			</section>
			<p id="status" role="status">Loading counts…</p>
			<p id="latest"></p>
		</main>
		<script>
			const status = document.querySelector('#status');
			fetch('/api/visitor-counts')
				.then((response) => {
					if (!response.ok) throw new Error('Unavailable');
					return response.json();
				})
				.then(({ homepage, ppt, latest }) => {
					document.querySelector('#homepage').textContent = homepage.toLocaleString();
					document.querySelector('#ppt').textContent = ppt.toLocaleString();
					status.textContent = 'Counts are up to date.';
					document.querySelector('#latest').textContent = latest
						? `Latest recorded load: ${new Date(latest).toLocaleString()}`
						: 'No visits recorded yet.';
				})
				.catch(() => { status.textContent = 'Counts are temporarily unavailable.'; });
		</script>
	</body>
</html>
