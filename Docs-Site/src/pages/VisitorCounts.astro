<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Visitor counts · DepthWizard</title>
		<style>
			:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #0d1014; color: #f2f5f7; }
			* { box-sizing: border-box; }
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
			main { width: min(100%, 680px); }
			p { color: #aab4c0; }
			h1 { margin: 0; font-size: clamp(2rem, 7vw, 3.25rem); letter-spacing: -.04em; }
			.eyebrow { margin: 0 0 .6rem; color: #8ca7bb; font: 600 .75rem/1.4 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
			.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
			.card, .chart-card { border: 1px solid #27313b; border-radius: 1rem; padding: 1.4rem; background: #141a20; }
			.label { margin: 0; font-size: .9rem; }
			.value { margin: .5rem 0 0; color: #75d8bb; font-size: clamp(2.5rem, 10vw, 4rem); font-variant-numeric: tabular-nums; line-height: 1; }
			.chart-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
			.chart-heading h2 { margin: 0; font-size: 1rem; }
			.legend { display: flex; gap: 1rem; color: #aab4c0; font-size: .8rem; }
			.legend span { display: inline-flex; align-items: center; gap: .4rem; }
			.legend i { display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; background: #75d8bb; }
			.legend span:last-child i { background: #f0b66d; }
			.visits-chart { display: block; width: 100%; height: auto; margin-top: 1rem; }
			#status, #latest { font-size: .9rem; }
			@media (max-width: 480px) { body { padding: 1.25rem; } .cards { grid-template-columns: 1fr; } .chart-card { padding: 1rem; } }
		</style>
	</head>
	<body>
		<main>
			<p class="eyebrow">DepthWizard · private dashboard</p>
			<h1>Visitor counts</h1>
			<p>Page loads recorded since tracking began. Daily graphs use UTC dates.</p>
			<section class="cards" aria-label="Visit totals" aria-live="polite">
				<article class="card">
					<p class="label">Homepage loads</p>
					<p class="value" id="homepage">—</p>
				</article>
				<article class="card">
					<p class="label">Homepage loads with <code>?ppt</code></p>
					<p class="value" id="ppt">—</p>
				</article>
			</section>
			<section class="chart-card" aria-labelledby="chart-title">
				<div class="chart-heading">
					<h2 id="chart-title">Loads per day · last 30 days</h2>
					<div class="legend" aria-hidden="true"><span><i></i>Homepage</span><span><i></i>?ppt</span></div>
				</div>
				<svg class="visits-chart" id="visits-chart" viewBox="0 0 720 280" role="img" aria-labelledby="chart-title chart-description">
					<desc id="chart-description">Grouped bars show daily homepage loads and loads with the ppt parameter.</desc>
				</svg>
			</section>
			<section class="cards" aria-label="Tracked page totals" aria-live="polite">
				<article class="card">
					<p class="label">Judges page opens</p>
					<p class="value" id="judges">—</p>
				</article>
				<article class="card">
					<p class="label">Download opens with <code>?ppt</code></p>
					<p class="value" id="downloadPpt">—</p>
				</article>
			</section>
			<section class="chart-card" aria-labelledby="page-chart-title">
				<div class="chart-heading">
					<h2 id="page-chart-title">Page opens per day · last 30 days</h2>
					<div class="legend" aria-hidden="true"><span><i></i>Judges</span><span><i></i>Download ?ppt</span></div>
				</div>
				<svg class="visits-chart" id="page-visits-chart" viewBox="0 0 720 280" role="img" aria-labelledby="page-chart-title page-chart-description">
					<desc id="page-chart-description">Grouped bars show daily opens of the judges page and the download page with the ppt parameter.</desc>
				</svg>
			</section>
			<p id="status" role="status">Loading counts…</p>
			<p id="latest"></p>
		</main>
		<script>
			const status = document.querySelector('#status');
			fetch('/api/visitor-counts')
				.then((response) => {
					if (!response.ok) throw new Error('Unavailable');
					return response.json();
				})
				.then(({ homepage, ppt, judges, downloadPpt, latest, daily }) => {
					document.querySelector('#homepage').textContent = homepage.toLocaleString();
					document.querySelector('#ppt').textContent = ppt.toLocaleString();
					document.querySelector('#judges').textContent = judges.toLocaleString();
					document.querySelector('#downloadPpt').textContent = downloadPpt.toLocaleString();
					drawChart(daily, '#visits-chart', [['homepage', 'Homepage'], ['ppt', 'Homepage ?ppt']]);
					drawChart(daily, '#page-visits-chart', [['judges', 'Judges'], ['downloadPpt', 'Download ?ppt']]);
					status.textContent = 'Counts are up to date.';
					document.querySelector('#latest').textContent = latest
						? `Latest recorded load: ${new Date(latest).toLocaleString()}`
						: 'No visits recorded yet.';
				})
				.catch(() => { status.textContent = 'Counts are temporarily unavailable.'; });

			function drawChart(days, selector, series) {
				const svg = document.querySelector(selector);
				const ns = 'http://www.w3.org/2000/svg';
				const left = 44, right = 12, top = 14, bottom = 42;
				const width = 720 - left - right, height = 280 - top - bottom;
				const peak = Math.max(0, ...days.flatMap((day) => series.map(([key]) => day[key])));
				const max = Math.max(5, Math.ceil(peak / 5) * 5);
				const add = (name, attrs, parent = svg) => {
					const node = document.createElementNS(ns, name);
					for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
					parent.append(node);
					return node;
				};

				for (let tick = 0; tick <= 5; tick++) {
					const y = top + height * tick / 5;
					add('line', { x1: left, x2: left + width, y1: y, y2: y, stroke: '#27313b', 'stroke-width': 1 });
					const label = add('text', {
						x: left - 9, y: y + 4, 'text-anchor': 'end', fill: '#aab4c0',
						'font-family': 'Inter, system-ui, sans-serif', 'font-size': 11,
					});
					label.textContent = String(Math.round(max * (5 - tick) / 5));
				}

				const groupWidth = width / days.length;
				const barWidth = Math.min(7, groupWidth * 0.3);
				for (const [index, day] of days.entries()) {
					const groupX = left + index * groupWidth;
					for (const [offset, [key, label]] of series.entries()) {
						const color = ['#75d8bb', '#f0b66d'][offset];
						const value = day[key];
						const barHeight = height * value / max;
						const bar = add('rect', {
							x: groupX + (groupWidth - 2 * barWidth - 2) / 2 + offset * (barWidth + 2),
							y: top + height - barHeight,
							width: barWidth,
							height: Math.max(value ? 1 : 0, barHeight),
							rx: 2,
							fill: color,
						});
						const title = add('title', {}, bar);
						title.textContent = `${day.date}: ${value} ${label} loads`;
					}
				}

				for (const index of [0, 7, 14, 21, 29]) {
					const day = days[index]?.date;
					if (!day) continue;
					const label = add('text', {
						x: left + groupWidth * (index + 0.5), y: 258, 'text-anchor': 'middle', fill: '#aab4c0',
						'font-family': 'Inter, system-ui, sans-serif', 'font-size': 11,
					});
					label.textContent = new Date(`${day}T00:00:00Z`).toLocaleDateString(undefined, {
						month: 'short', day: 'numeric', timeZone: 'UTC',
					});
				}
			}
		</script>
	</body>
</html>
