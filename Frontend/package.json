{
  "name": "depthwizard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "DepthWizard — single-view height estimation and 3D flythrough (SIH 2026 PS 26175)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "serve": "node server/serve.mjs",
    "make-sample": "node scripts/sample-from-space.mjs",
    "cache-dem": "node scripts/cache-dem.mjs",
    "pack-sample": "node scripts/pack-sample.mjs",
    "cache-osm": "node scripts/cache-osm.mjs",
    "desktop:install": "install-electron",
    "desktop:dev": "npm run build && electron .",
    "desktop:backend": "python desktop/build-backend.py",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "desktop:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "desktop:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "desktop:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux --x64 --publish never",
    "desktop:test": "node --test desktop/*.test.mjs",
    "desktop:smoke": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mantine/core": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/modals": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@tabler/icons-react": "^3.48.0",
    "camera-controls": "^3.1.2",
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "idb-keyval": "^6.3.0",
    "postprocessing": "^6.38.0",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "three": "^0.186.1",
    "three-custom-shader-material": "^6.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "desktop/main.mjs",
  "author": "DepthWizard contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
