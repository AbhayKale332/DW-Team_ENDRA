# Copy to .env and fill in. .env is git-ignored.

# Hugging Face access token with READ access to the private Space.
# Server-side only: used by the Vite dev/preview proxy and server/serve.mjs.
# Deliberately NOT prefixed with VITE_ — Vite would otherwise embed it in the browser bundle.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The DepthWizard model Space (owner/name). Its direct URL is derived from this.
VITE_SPACE_ID=akashch1512/SingleViewHeigthEstimation
# Optional override if the direct URL differs from the derived one.
# HF_SPACE_URL=https://akashch1512-singleviewheigthestimation.hf.space

# Port for `npm run serve` (production server).
# PORT=8080

# Production proxy guards (server/serve.mjs).
# Behind a reverse proxy / PaaS router, set TRUST_PROXY=1 so rate limits apply per real client (X-Forwarded-For).
# TRUST_PROXY=1
# Model runs allowed per client per window (uploads get twice this).
# RATE_LIMIT_RUNS=10
# RATE_LIMIT_WINDOW_MIN=10
# Set CSP=off only to debug a Content-Security-Policy problem.
# CSP=on
